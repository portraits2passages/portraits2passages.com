---
interface Props { href: string; titre: string; description: string; couverture: string; }
const { href, titre, description, couverture } = Astro.props;
---
<article class="carte-edition">
  <a href={href}>
    <img src={couverture} alt="" loading="lazy" width="640" height="360" />
    <div class="carte-edition-texte">
      <h3>{titre}</h3>
      <p>{description}</p>
    </div>
  </a>
</article>
