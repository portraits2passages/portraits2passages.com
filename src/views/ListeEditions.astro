---
import type { Page } from 'astro';
import type { CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import CarteEdition from '../components/CarteEdition.astro';
import { t, routes, editionUrl, type Lang } from '../i18n';
interface Props { lang: Lang; page: Page<CollectionEntry<'editions'> | CollectionEntry<'editionsEn'>>; }
const { lang, page } = Astro.props;
const tx = t(lang);
const autre = routes.editions[lang === 'fr' ? 'en' : 'fr'] + (page.currentPage > 1 ? `/${page.currentPage}` : '');
---
<Base lang={lang} alternate={autre} titre={page.currentPage > 1 ? `${tx.nav.editions} (${tx.page.toLowerCase()} ${page.currentPage})` : tx.nav.editions} description={tx.editionsDescription}>
  <section class="conteneur section">
    <h1>{tx.editionsTitre}</h1>
    <div class="grille">{page.data.map(e => <CarteEdition href={editionUrl(lang, e.id)} {...e.data} />)}</div>
    {page.lastPage > 1 && (
      <nav class="pagination" aria-label={tx.pagination}>
        {page.url.prev && <a href={page.url.prev}>{tx.plusRecentes}</a>}
        <span>{tx.page} {page.currentPage} / {page.lastPage}</span>
        {page.url.next && <a href={page.url.next}>{tx.plusAnciennes}</a>}
      </nav>
    )}
  </section>
</Base>
