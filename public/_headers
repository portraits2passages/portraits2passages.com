# En-têtes de sécurité — format Cloudflare Pages / Netlify (ignoré par les autres hébergeurs)
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.bunny.net; font-src 'self' https://fonts.bunny.net; img-src 'self' data: https://i.ytimg.com; frame-src https://www.youtube-nocookie.com https://umap.openstreetmap.fr; connect-src 'self'; form-action 'self' https://api.web3forms.com; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  X-Frame-Options: DENY

# Adresses de test Cloudflare (workers.dev) : ne pas indexer dans les moteurs de recherche
https://:sous-domaine.contact-584.workers.dev/*
  X-Robots-Tag: noindex
