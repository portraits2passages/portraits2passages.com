---
// Façade « cliquer pour lire » : rien n'est chargé depuis YouTube avant le clic, donc pas de bandeau cookies nécessaire.
import { t, type Lang } from '../i18n';
interface Props { id: string; titre: string; lang: Lang; }
const { id, titre, lang } = Astro.props;
const tx = t(lang);
---
<div class="video" data-id={id} data-titre={titre}>
  <button type="button" aria-label={`${tx.videoLire} ${titre}`} style={`background-image:url(https://i.ytimg.com/vi/${id}/hqdefault.jpg)`}>
    <span class="video-play" aria-hidden="true">▶</span>
  </button>
  <p class="video-note">{tx.videoNote}</p>
</div>
<script>
  document.querySelectorAll<HTMLElement>('.video').forEach(el => {
    el.querySelector('button')?.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${el.dataset.id}?autoplay=1`;
      iframe.title = el.dataset.titre ?? '';
      iframe.allow = 'autoplay; encrypted-media; picture-in-picture';
      iframe.allowFullscreen = true;
      el.replaceChildren(iframe);
      iframe.focus();
    });
  });
</script>
