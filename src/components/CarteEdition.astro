---
import { t, type Lang } from '../i18n';
interface Props { href: string; titre: string; description: string; couverture: string; date: Date; lang: Lang; niveau?: 2 | 3; chargement?: 'lazy' | 'eager'; }
const { href, titre, description, couverture, date, lang, niveau = 3, chargement = 'lazy' } = Astro.props;
const Titre = `h${niveau}`;
---
<article class="carte-edition">
  <a href={href}>
    <div class="carte-edition-image">
      <img src={couverture} alt="" loading={chargement} decoding="async" width="640" height="360" />
      <span class="badge-annee">{date.getFullYear()}</span>
    </div>
    <div class="carte-edition-texte">
      <Titre>{titre}</Titre>
      <p>{description}</p>
      <span class="lire" aria-hidden="true">{t(lang).lireRecit} →</span>
    </div>
  </a>
</article>
