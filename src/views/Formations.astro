---
import Base from '../layouts/Base.astro';
import { t, routes, type Lang } from '../i18n';
import { formations } from '../data/contenu';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const tx = t(lang);
const f = formations(lang);
---
<Base lang={lang} alternate={routes.formations[lang === 'fr' ? 'en' : 'fr']} titre={f.titre} description={tx.formationsMeta}>
  <section class="conteneur section">
    <h1>{f.titre}</h1>
    <p class="intro-page">{f.intro}</p>

    <h2>{f.actionsTitre}</h2>
    <div class="grille actions">
      {f.actions.map(a => (
        <article class="action">
          <h3>{a.titre}</h3>
          <p>{a.texte}</p>
        </article>
      ))}
    </div>
  </section>


  <section class="section fond-clair centre">
    <div class="conteneur etroit">
      <h2>{tx.formationsCta}</h2>
      <p>{tx.formationsCtaTexte}</p>
      <a class="bouton" href={routes.contact[lang]}>{tx.parlonsEn}</a>
    </div>
  </section>

  <section class="conteneur section">
    <h2>{f.referencesTitre}</h2>
    <ol class="references">
      {f.references.map(r => (
        <li>
          <span class="periode">{r.periode}</span>
          <div>
            <strong>{r.lien ? <a href={r.lien} rel="noopener">{r.titre}</a> : r.titre}</strong>
            <p>{r.detail}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>
</Base>
