---
import Base from '../layouts/Base.astro';
import { Content } from '../content/mentions-legales.md';
import { t, routes } from '../i18n';
const tx = t('fr');
---
<Base lang="fr" alternate={routes.mentions.en} titre={tx.mentions} description={tx.mentionsMeta}>
  <section class="conteneur etroit section prose">
    <h1>{tx.mentions}</h1>
    <Content />
  </section>
</Base>
