---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import CarteEdition from '../components/CarteEdition.astro';
import accueil from '../data/accueil.json';
const dernieres = (await getCollection('editions')).sort((a, b) => +b.data.date - +a.data.date).slice(0, 3);
const paragraphes = (t: string) => t.split('\n\n');
---
<Base>
  <section class="hero" style={`background-image:linear-gradient(rgba(34,50,97,.55),rgba(34,50,97,.55)),url(${accueil.imageMission})`}>
    <div class="conteneur">
      <h1>Portraits 2 Passages</h1>
      <p class="hero-sous-titre">Notre mission</p>
      <p class="hero-texte">{accueil.mission}</p>
    </div>
  </section>

  <section class="conteneur section etroit">
    {paragraphes(accueil.questions).map(p => <p class="grand">{p}</p>)}
  </section>

  <section class="section fond-clair">
    <div class="conteneur etroit">
      <h2>Formations et accompagnements</h2>
      {paragraphes(accueil.formations).map(p => <p>{p}</p>)}
      <a class="bouton" href="/formations">Plus d'infos</a>
    </div>
  </section>

  <section class="conteneur section">
    <h2>Les dernières vidéos</h2>
    <div class="grille">{dernieres.map(e => <CarteEdition edition={e} />)}</div>
    <p class="centre"><a class="bouton secondaire" href="/editions">Toutes les éditions</a></p>
  </section>

  <section class="section fond-clair">
    <div class="conteneur">
      <h2>Qui sommes-nous ?</h2>
      <div class="etroit">{paragraphes(accueil.quiSommesNous).map(p => <p>{p}</p>)}</div>
      <div class="grille equipe">
        {accueil.equipe.map(m => (
          <figure class="membre">
            <img src={m.photo} alt={m.nom} loading="lazy" width="240" height="240" />
            <figcaption><strong>{m.nom}</strong><span>{m.role}</span><p>{m.bio}</p></figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>
</Base>
