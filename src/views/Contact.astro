---
import Base from '../layouts/Base.astro';
import Formulaire from '../components/Formulaire.astro';
import site from '../data/site.json';
import { t, routes, type Lang } from '../i18n';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const tx = t(lang);
---
<Base lang={lang} alternate={routes.contact[lang === 'fr' ? 'en' : 'fr']} titre={tx.nav.contact} description={tx.contactMeta}>
  <section class="conteneur etroit section">
    <h1>{tx.nav.contact}</h1>
    <p>{tx.contactIntro} <a href={`mailto:${site.email}`}>{site.email}</a>.</p>
    <Formulaire lang={lang} />
  </section>
</Base>
