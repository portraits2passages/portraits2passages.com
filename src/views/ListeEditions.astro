---
import Base from '../layouts/Base.astro';
import CarteEdition from '../components/CarteEdition.astro';
import { t, routes, editionUrl, type Lang } from '../i18n';
import { getEditions } from '../editions';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const tx = t(lang);
const editions = await getEditions(lang);
---
<Base lang={lang} alternate={routes.editions[lang === 'fr' ? 'en' : 'fr']} titre={tx.nav.editions} description={tx.editionsDescription}>
  <section class="conteneur section">
    <h1>{tx.editionsTitre}</h1>
    <!-- Toutes les éditions sur une page : les vignettes hors écran ne se chargent qu'en approchant au défilement (loading="lazy"). -->
    <div class="grille">{editions.map((e, i) => <CarteEdition href={editionUrl(lang, e.id)} {...e.data} niveau={2} chargement={i < 3 ? 'eager' : 'lazy'} />)}</div>
  </section>
</Base>
