---
import Edition from '../../views/Edition.astro';
import { getEditions } from '../../editions';

export async function getStaticPaths() {
  const en = new Set((await getEditions('en')).map(e => e.id));
  return (await getEditions('fr')).map(e => ({ params: { slug: e.id }, props: { edition: e, traduite: en.has(e.id) } }));
}
---
<Edition lang="fr" edition={Astro.props.edition} traduite={Astro.props.traduite} />
