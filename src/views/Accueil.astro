---
import Base from '../layouts/Base.astro';
import CarteEdition from '../components/CarteEdition.astro';
import { t, routes, editionUrl, type Lang } from '../i18n';
import { getEditions } from '../editions';
import { accueil as donnees } from '../data/contenu';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const tx = t(lang);
const accueil = donnees(lang);
const dernieres = (await getEditions(lang)).slice(0, 3);
const paragraphes = (s: string) => s.split('\n\n');
---
<Base lang={lang} alternate={routes.accueil[lang === 'fr' ? 'en' : 'fr']}>
  <section class="hero" style={`--hero-image:url(${accueil.imageMission})`}>
    <div class="conteneur hero-in">
      <h1>Portraits 2 Passages</h1>
      <p class="hero-texte">{accueil.mission}</p>
    </div>
    <p class="hero-credit">{accueil.imageCredit.legende} — <a href={accueil.imageCredit.source} rel="noopener">{accueil.imageCredit.auteur}</a>, <a href={accueil.imageCredit.licenceUrl} rel="noopener license">{accueil.imageCredit.licence}</a></p>
  </section>

  <section class="conteneur section etroit questions">
    {paragraphes(accueil.questions).map(p => <p class="grand">{p}</p>)}
  </section>

  <section class="section fond-clair">
    <div class="conteneur etroit">
      <h2>{accueil.actionsTitre}</h2>
      {paragraphes(accueil.formations).map(p => <p>{p}</p>)}
      <p class="actions-boutons">
        <a class="bouton" href={routes.contact[lang]}>{tx.parlonsEn}</a>
        <a class="bouton secondaire" href={routes.formations[lang]}>{tx.voirFormations}</a>
      </p>
    </div>
  </section>

  <section class="conteneur section">
    <h2>{tx.dernieresVideos}</h2>
    <div class="grille">{dernieres.map(e => <CarteEdition href={editionUrl(lang, e.id)} {...e.data} lang={lang} />)}</div>
    <p class="centre"><a class="bouton secondaire" href={routes.editions[lang]}>{tx.toutesEditions}</a></p>
  </section>

  <section class="section fond-clair">
    <div class="conteneur">
      <h2>{tx.quiSommesNous}</h2>
      <div class="etroit">{paragraphes(accueil.quiSommesNous).map(p => <p>{p}</p>)}</div>
      <div class="grille equipe">
        {accueil.equipe.map(m => (
          <figure class="membre">
            <img src={m.photo} alt={m.nom} loading="lazy" width="240" height="240" />
            <figcaption><strong>{m.nom}</strong><span>{m.role}</span><p>{m.bio}</p></figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>
</Base>
